# Resend (https://resend.com). Leave RESEND_API_KEY empty to log emails to the server console instead.
RESEND_API_KEY=
# Where inquiries and contact messages are delivered.
INQUIRY_TO_EMAIL=melody@theflowerbunny.com
# Sender. Use onboarding@resend.dev until lefaon.com is verified in Resend.
INQUIRY_FROM_EMAIL=onboarding@resend.dev
# Public site URL, used for metadata and links in emails.
# Leave empty locally and on previews (links use the current domain). Set to https://lefaon.com in production.
NEXT_PUBLIC_SITE_URL=
